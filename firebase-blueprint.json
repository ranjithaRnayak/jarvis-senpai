{
  "entities": {
    "Material": {
      "title": "Material",
      "description": "An inventory item or scanned raw material document with batch and shelf life metadata.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Material or item name"
        },
        "category": {
          "type": "string",
          "description": "Category or classification"
        },
        "batchNo": {
          "type": "string",
          "description": "Batch number, lot number, or reference identifier"
        },
        "purchaseDate": {
          "type": "string",
          "description": "Purchase or manufacture date in YYYY-MM-DD"
        },
        "shelfLifeDays": {
          "type": "number",
          "description": "Shelf life in days"
        },
        "expiryDate": {
          "type": "string",
          "description": "Calculated expiry date in YYYY-MM-DD"
        },
        "quantity": {
          "type": "number",
          "description": "Quantity count"
        },
        "unit": {
          "type": "string",
          "description": "Unit of measurement"
        },
        "confidence": {
          "type": "number",
          "description": "Gemini extraction confidence score"
        },
        "status": {
          "type": "string",
          "enum": ["ok", "expiring", "expired"],
          "description": "Current status of the material"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["name", "batchNo", "purchaseDate", "expiryDate", "quantity", "unit", "status"]
    },
    "BatchUsageLog": {
      "title": "BatchUsageLog",
      "description": "A historical usage log, dispensing record, or adjustment for a specific batch/LOT number.",
      "type": "object",
      "properties": {
        "batchNo": {
          "type": "string",
          "description": "The specific Batch/LOT identifier"
        },
        "materialId": {
          "type": "string",
          "description": "Associated material document ID"
        },
        "materialName": {
          "type": "string",
          "description": "Name of the material item"
        },
        "action": {
          "type": "string",
          "enum": ["initial_stock", "dispensed", "qc_inspection", "adjustment", "disposed"],
          "description": "Type of batch activity"
        },
        "quantityChange": {
          "type": "number",
          "description": "Amount added or consumed (e.g. -5, +20)"
        },
        "remainingQuantity": {
          "type": "number",
          "description": "Remaining stock balance after this activity"
        },
        "unit": {
          "type": "string",
          "description": "Unit of measurement"
        },
        "purposeOrNotes": {
          "type": "string",
          "description": "Operational notes or purpose for usage"
        },
        "operator": {
          "type": "string",
          "description": "Name of the technician or user who performed the action"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp of when the event occurred"
        }
      },
      "required": ["batchNo", "action", "quantityChange", "unit", "timestamp"]
    },
    "Alert": {
      "title": "Alert",
      "description": "Computed inventory alert for expiration, low stock, or stock-out risk.",
      "type": "object",
      "properties": {
        "materialId": { "type": "string" },
        "materialName": { "type": "string" },
        "type": { "type": "string", "enum": ["expired", "expiring_soon", "low_stock", "stockout_risk"] },
        "severity": { "type": "string", "enum": ["low", "med", "high"] },
        "message": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "resolved"] },
        "evidence": { "type": "object" },
        "actionable": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["materialId", "materialName", "type", "severity", "message", "reason", "status"]
    },
    "Order": {
      "title": "Order",
      "description": "Purchase order requisition draft and approval record.",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string" },
        "materialId": { "type": "string" },
        "materialName": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "unitPrice": { "type": "number" },
        "estimatedCost": { "type": "number" },
        "currency": { "type": "string" },
        "status": { "type": "string", "enum": ["pending_approval", "approved", "rejected"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["orderNumber", "materialId", "materialName", "supplierId", "quantity", "unit", "status"]
    }
  },
  "firestore": {
    "/materials/{materialId}": {
      "schema": "Material",
      "description": "Collection of scanned materials and inventory items."
    },
    "/batchUsageLogs/{logId}": {
      "schema": "BatchUsageLog",
      "description": "Collection of historical batch activities and dispensing usage logs."
    },
    "/alerts/{alertId}": {
      "schema": "Alert",
      "description": "Collection of active and resolved inventory alerts."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of draft and approved purchase orders."
    }
  }
}
