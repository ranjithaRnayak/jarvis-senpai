rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /materials/{materialId} {
      allow read, write: if true;
      match /usageLogs/{logId} {
        allow read, write: if true;
      }
    }
    match /batchUsageLogs/{logId} {
      allow read, write: if true;
    }
    match /alerts/{alertId} {
      allow read, write: if true;
    }
    match /orders/{orderId} {
      allow read, write: if true;
    }
  }
}
